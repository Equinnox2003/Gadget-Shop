# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Keep web-build tracked so the browser launcher works from a GitHub clone.
tmp/
.tmp-check/
*.db
*.db-wal
*.db-shm
# Exported web assets are copied under this nested dependency path by Expo.
!/web-build/assets/node_modules/
!/web-build/assets/node_modules/**
